# ============================================================
# Darukaa.Earth — Frontend Environment (Vite)
# ============================================================
# Copy to frontend/.env.local for local dev, or set in Vercel
# project settings for production deployment.

# Backend API base URL — set to your Render service URL in production
# Leave empty for local development (Vite dev proxy handles /api/* routing)
VITE_API_BASE_URL=

# Production example (set in Vercel Dashboard → Settings → Environment Variables):
# VITE_API_BASE_URL=https://darukaa-ai-chatbot.onrender.com
