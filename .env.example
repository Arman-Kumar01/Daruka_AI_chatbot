# ============================================================
# Darukaa.Earth AI Biodiversity Intelligence Platform
# Backend Environment Configuration
# ============================================================
# Copy to .env and fill in values. Never commit .env to git.

# --- LLM API Keys (Optional) ---
# System runs in local deterministic mode without these.
# If provided, Gemini/OpenAI will be used for richer responses.
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- LLM Configuration ---
LLM_PROVIDER=auto        # Options: auto, gemini, openai, local
DEFAULT_MODEL=gemini-1.5-flash

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000                # Render automatically injects $PORT — do not override on Render
DEBUG=false              # Set true for local development only

# --- CORS (Production) ---
# Set to your Vercel frontend URL in production (comma-separated for multiple)
# Leave as * only for local development
ALLOWED_ORIGINS=*
# Production example:
# ALLOWED_ORIGINS=https://darukaa-ai-chatbot.vercel.app

# --- RAG & Knowledge Base ---
# Path to ChromaDB persistent storage. Defaults to data/chroma_db/
# On Render free tier (ephemeral disk), the TF-IDF index is rebuilt on startup from
# repo-controlled data/raw/*.json files — no persistent disk required.
CHROMA_PERSIST_DIR=./data/chroma_db
